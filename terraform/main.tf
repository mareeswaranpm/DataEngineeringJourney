terraform {
  required_version = ">= 1.0"

  required_providers {
    local = {
      source  = "hashicorp/local"
      version = "~> 2.0"
    }
  }
}

provider "local" {}

variable "engineer" {
  description = "Name of the engineer"
  type        = string
  default     = "Marees"
}

locals {
  project_name = "DataEngineeringJourney"
}

resource "local_file" "report" {
  filename = "terraform_report.txt"

  content = <<EOT
Project  : ${local.project_name}
Engineer : ${var.engineer}

Skills learned:
- Python
- SQL
- Git
- Docker
- GitHub Actions
- Terraform

Generated by Terraform
EOT
}

output "welcome_message" {
  value = "Welcome ${var.engineer} to Terraform"
}

output "report_location" {
  value = local_file.report.filename
}
